# Copy to streamlit_app/.streamlit/secrets.toml (local) or paste into the
# app's Secrets on Streamlit Cloud.
#
# Supabase: Dashboard -> Connect -> "Session pooler" string (port 5432).
# Keep the +psycopg2 prefix. A password containing @ must be written %40.

[connections.steel]
url = "postgresql+psycopg2://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Local testing without Supabase (a file next to app.py):
# [connections.steel]
# url = "sqlite:///steeltrack_local.db"
